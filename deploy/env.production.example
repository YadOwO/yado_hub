# 服务器上的 /opt/yado/yado-hub/.env 模板。属主必须是 yado（部署以 yado 用户执行 compose）。
PORT=7791
NODE_ENV=production
# yado_hub 角色与 schema 由 deploy/postgres-init.sql 创建
DATABASE_URL=postgres://yado_hub:<密码>@postgres:5432/yado
LOGTO_ISSUER=https://accounts.yado1225.top/oidc
# 必须与 Logto 后台 API 资源标识符逐字一致，且创建后不可修改
LOGTO_AUDIENCE=https://api.yado1225.top/hub
AUTH_DEV_BYPASS=false
# 管理员的 Logto 用户 ID，逗号分隔（Logto Console → 用户管理 → 用户详情里的 User ID）
ADMIN_USER_IDS=
CORS_ORIGINS=*

FEEDBACK_RATE_LIMIT_PER_MINUTE=10
FEEDBACK_RATE_LIMIT_PER_DAY=100
