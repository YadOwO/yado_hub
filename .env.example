# ---- 服务 ----
# 与 yadoi-be（7788）、yadoa-be（7789）、yado-ai（7790）错开，便于本地同时运行
PORT=7791
NODE_ENV=development

# ---- 数据库 ----
# 本服务只读写 yado_hub schema；本地复用 yadoA_be / yadoI_be 的 yado-postgres 容器
DATABASE_URL=postgres://yado:yado@localhost:5432/yado

# ---- 认证（Logto）----
LOGTO_ISSUER=https://accounts.yado1225.top/oidc
# 本服务在 Logto 中注册的 API resource indicator，作为 JWT 的 audience 校验
# 资源标识符，不是真实地址；与 Logto 后台逐字一致
LOGTO_AUDIENCE=https://api.yado1225.top/hub
# JWKS 地址，留空时自动推导为 ${LOGTO_ISSUER}/jwks
# LOGTO_JWKS_URL=

# 本地开发绕过 JWT 校验，用固定用户身份调试；NODE_ENV=production 时该配置强制失效
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=dev-user-0001

# ---- 管理员 ----
# 管理员的 Logto 用户 ID，逗号分隔；本地免鉴权调试管理端时填 AUTH_DEV_USER_ID
ADMIN_USER_IDS=

# ---- 跨域 ----
CORS_ORIGINS=*

# ---- 限流（每个用户发反馈消息）----
FEEDBACK_RATE_LIMIT_PER_MINUTE=10
FEEDBACK_RATE_LIMIT_PER_DAY=100
