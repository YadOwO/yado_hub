{
  "name": "yado-hub",
  "version": "0.1.0",
  "private": true,
  "description": "芽豆系列产品共用的通用业务服务（意见反馈等）",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-openapi": "^1.5.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.12.32",
    "jose": "^6.2.5",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
