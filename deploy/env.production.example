# 服务器上的 /opt/yado/yado-hub/.env 模板。属主必须是 yado（部署以 yado 用户执行 compose）。
PORT=7791
NODE_ENV=production
# yado_hub 角色与 schema 由 deploy/postgres-init.sql 创建
DATABASE_URL=postgres://yado_hub:<密码>@postgres:5432/yado
LOGTO_ISSUER=https://accounts.yado1225.top/oidc
# 必须与 Logto 后台 API 资源标识符逐字一致，且创建后不可修改
LOGTO_AUDIENCE=https://api.yado1225.top/hub
AUTH_DEV_BYPASS=false
# 管理员的 Logto 用户 ID，逗号分隔（Logto Console → 用户管理 → 用户详情里的 User ID）
ADMIN_USER_IDS=
CORS_ORIGINS=*

FEEDBACK_RATE_LIMIT_PER_MINUTE=10
FEEDBACK_RATE_LIMIT_PER_DAY=100

# 允许同步 agent 状态的机器：机器ID:凭证的 sha256，逗号分隔。由 Mac 上的 agentctl hub setup 打印，只含哈希
AGENT_MACHINE_TOKENS=

# 注销账号：按顺序调用的下游服务（compose 服务名与容器端口，走 yado-net 内网，不经 nginx）
ACCOUNT_DELETION_SERVICES=yado-ai=http://yado-ai:7790,yadoa-be=http://yadoa-be:7789,yadoi-be=http://yadoi-be:7788
# 发给每个下游的机器凭证明文，各不相同：openssl rand -hex 32；对方 .env 的 INTERNAL_MACHINE_TOKENS 存 yado-hub:<凭证的 sha256>
ACCOUNT_DELETION_TOKENS=yado-ai:<凭证>,yadoa-be:<凭证>,yadoi-be:<凭证>
# 删除 Logto 用户用的 Machine-to-Machine 应用（以前配在 yadoa-be 的 .env，现在只有 hub 需要）
LOGTO_M2M_APP_ID=<M2M 应用 ID>
LOGTO_M2M_APP_SECRET=<M2M 应用密钥>
# LOGTO_MANAGEMENT_RESOURCE=https://default.logto.app/api
