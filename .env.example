# ---- 服务 ----
# 与 yadoi-be（7788）、yadoa-be（7789）、yado-ai（7790）错开，便于本地同时运行
PORT=7791
NODE_ENV=development

# ---- 数据库 ----
# 本服务只读写 yado_hub schema；本地复用 yadoA_be / yadoI_be 的 yado-postgres 容器
DATABASE_URL=postgres://yado:yado@localhost:5432/yado

# ---- 认证（Logto）----
LOGTO_ISSUER=https://accounts.yado1225.top/oidc
# 本服务在 Logto 中注册的 API resource indicator，作为 JWT 的 audience 校验
# 资源标识符，不是真实地址；与 Logto 后台逐字一致
LOGTO_AUDIENCE=https://api.yado1225.top/hub
# JWKS 地址，留空时自动推导为 ${LOGTO_ISSUER}/jwks
# LOGTO_JWKS_URL=

# 本地开发绕过 JWT 校验，用固定用户身份调试；NODE_ENV=production 时该配置强制失效
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=dev-user-0001

# ---- 管理员 ----
# 管理员的 Logto 用户 ID，逗号分隔；本地免鉴权调试管理端时填 AUTH_DEV_USER_ID
ADMIN_USER_IDS=

# ---- 跨域 ----
CORS_ORIGINS=*

# ---- 限流（每个用户发反馈消息）----
FEEDBACK_RATE_LIMIT_PER_MINUTE=10
FEEDBACK_RATE_LIMIT_PER_DAY=100

# ---- agent 同步 ----
# 允许同步 agent 状态的机器：机器ID:凭证的 sha256，逗号分隔。由 Mac 上的 agentctl hub setup 打印
AGENT_MACHINE_TOKENS=

# ---- 注销账号 ----
# 各 App 注销只调 hub 的 DELETE /v1/account：hub 写注销名单、删意见反馈，再按下面的顺序调各服务的
# DELETE /internal/v1/users/{userId}，全部成功后用 Logto Management API 删除 Logto 用户。详见 README「注销账号」。
# 下游服务：服务名=容器内网地址，逗号分隔，按调用顺序；新的产品后端接入时在这里加一项。
# 留空时真实用户注销返回 503；开发态免鉴权的假用户只删 hub 自己的数据（配了下游就一并调）。
# 线上与 dev 例：yado-ai=http://yado-ai:7790,yadoa-be=http://yadoa-be:7789,yadoi-be=http://yadoi-be:7788
ACCOUNT_DELETION_SERVICES=
# 发给每个下游服务的机器凭证：服务名:凭证，逗号分隔，每个服务一个、互不相同，用 openssl rand -hex 32 生成。
# 对方 .env 的 INTERNAL_MACHINE_TOKENS 填 yado-hub:<凭证的 sha256>（printf %s "$TOKEN" | shasum -a 256）
ACCOUNT_DELETION_TOKENS=
# Logto Machine-to-Machine 应用（分配带 Logto Management API「all」权限的角色），注销的最后一步用它删除 Logto 用户。
# 留空时真实用户注销返回 503，开发态免鉴权的假用户不受影响
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
# Management API 的 resource indicator，留空即 Logto 内置值 https://default.logto.app/api
LOGTO_MANAGEMENT_RESOURCE=
# 芽豆各 App 在 Logto 的原生应用 ID，逗号分隔。注销前验证身份有三种方式（密码、邮箱验证码、重新登录），
# 重新登录时 App 交来的 ID token 的 aud 必须是其中之一；留空时只有这种方式返回 503，密码和邮箱验证码不受影响
LOGTO_APP_IDS=
